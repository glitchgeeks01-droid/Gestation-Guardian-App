rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Existing users rule
    match /users/{userId} {
      allow read: if request.auth != null; 
      allow write: if request.auth.uid == userId; 
      
      // Match nested telemetry subcollections
      // FIX: Only the owning patient can write their own telemetry
      match /telemetry/{telemetryId} {
        allow read: if request.auth != null;
        allow write: if request.auth.uid == userId;
      }
    }

    // The Handshake State Machine
    match /pairing_requests/{requestId} {
      // SYN: Providers can create a request
      allow create: if request.auth != null 
                    && request.resource.data.providerId == request.auth.uid
                    && request.resource.data.status == 'pending';
                    
      // ACK: Providers can read requests they initiated to listen for changes
      allow read: if request.auth != null 
                  && resource.data.providerId == request.auth.uid;

      // Providers can delete their own resolved requests (cleanup after ACK)
      allow delete: if request.auth != null
                    && resource.data.providerId == request.auth.uid;
                    
      // SYN-ACK: Patients can read requests targeted at them
      allow read: if request.auth != null 
                  && resource.data.patientId == request.auth.uid;
                  
      // Patients can update requests to approve or deny them
      allow update: if request.auth != null 
                    && resource.data.patientId == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
                    && request.resource.data.status in ['approved', 'denied'];
    }
  }
}
