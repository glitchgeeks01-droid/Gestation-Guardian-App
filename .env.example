# ==============================================================================
# Gestation Guardian - Environment Configuration Template (.env.example)
# Classification: Public / Developer Guidance Template
# Security Requirement S1: ZERO secrets or production credentials in source code.
# Copy this file to '.env' for local development and replace placeholders.
# ==============================================================================

# Application Runtime Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (PostgreSQL 16)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://gestation_user:gestation_secure_dev_password@localhost:5432/gestation_guardian
POSTGRES_USER=gestation_user
POSTGRES_PASSWORD=gestation_secure_dev_password
POSTGRES_DB=gestation_guardian
POSTGRES_PORT=5432

# Authentication & Session Security (S4)
# Minimum 32-character high-entropy secret for HMAC / signing operations
JWT_SECRET=replace_with_a_secure_random_jwt_secret_at_least_32_characters_long
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Cryptographic Envelope Encryption & Key Management (S14)
# Master Key Encryption Key (KEK) ID in Cloud KMS or LocalStack KMS emulator
KMS_KEY_ID=12345678-1234-1234-1234-123456789012
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Network & CORS Security (API5, S15)
# Explicit origin whitelist; wildcard '*' is strictly prohibited
CORS_ORIGIN=http://localhost:5173

# Rate Limiting & Abuse Prevention (S6, API3)
# RATE_LIMIT_WINDOW_MS: Window duration in milliseconds (default: 900000 = 15 minutes)
# RATE_LIMIT_MAX_REQUESTS: Maximum allowed requests per window
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=5

# Document & Diagnostic Storage Pipeline (S17, API8)
# Private storage bucket for envelope-encrypted ultrasound and diagnostic scans
UPLOAD_BUCKET_NAME=gestation-guardian-encrypted-docs-dev
MAX_UPLOAD_FILE_SIZE_BYTES=10485760
